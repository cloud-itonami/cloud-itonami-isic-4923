;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a robot may perform the physical work of road
;; freight (ISIC 4923) -- yard-tractor spotting and automated loading-dock
;; handling. Here: an autonomous yard tractor pulling a loaded semi-trailer
;; up the approach to a raised dock door, and a pallet AMR driving loaded
;; pallets over the dock leveler into the trailer.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-4923"
 :cases
 [{:id :yard-tractor-spot-trailer
   :kind :transport
   :procedure "autonomous yard tractor (10 t) pulls a loaded 35 t semi-trailer 150 m across the yard and up the approach to a dock door"
   :params {:mass-kg 10000.0 :payload-kg 35000.0 :distance-m 150.0 :v-max-mps 4.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.5 :drive-force-n 60000.0 :crr 0.008 :cog-height-m 1.2
            :support-half-length-m 2.0 :max-time-s 900.0}
   :sweep {:param :slope-deg :values [0.0 2.0 4.0 6.0 7.0 8.0]}
   :quantity :cycle-time-s
   :limit {:max 90.0 :basis "estimate: one spotting move should fit a 1.5 min slot in the yard plan; a stall (tractive effort below grade + rolling resistance) is out of tolerance"}
   :boundary {:lo 0.0 :hi 12.0}}
  {:id :pallet-amr-over-dock-leveler
   :kind :transport
   :procedure "pallet AMR carries a loaded pallet 6 m from the dock floor over an 8 degree dock leveler into the trailer; the pallet weight is swept"
   :params {:mass-kg 300.0 :distance-m 6.0 :v-max-mps 0.8 :a-max-mps2 0.3
            :brake-decel-mps2 1.0 :drive-force-n 2500.0 :crr 0.015 :slope-deg 8.0
            :cog-height-m 0.30 :payload-cog-height-m 0.95 :support-half-length-m 0.50 :max-time-s 600.0}
   :sweep {:param :payload-kg :values [200.0 500.0 800.0 1100.0 1400.0]}
   :quantity :cycle-time-s
   :limit {:max 15.0 :basis "estimate: the AMR should clear the leveler within ~15 s per pallet to hold the loading rate; a stall on the incline is out of tolerance"}
   :boundary {:lo 50.0 :hi 3000.0}}]}
