(ns roadfreightops.store-contract-test
  "Contract tests for `roadfreightops.store/Store` protocol."
  (:require [kotoba.test :refer [deftest is testing]]
            [roadfreightops.store :as store]))

(deftest mem-store-carrier-lookup
  (testing "MemStore can store and retrieve carriers by ID (string keys)"
    (let [carriers {"c1" {:carrier-id "c1" :name "Alice's Freight Lines" :registered? true :verified? true}}
          s (store/mem-store carriers)]
      (is (some? (store/carrier-record s "c1")))
      (is (nil? (store/carrier-record s "c99"))))))

(deftest mem-store-all-carrier-records
  (testing "MemStore returns all carriers in sorted order"
    (let [carriers {"c2" {:carrier-id "c2" :name "Bob's Trucking Co"}
                    "c1" {:carrier-id "c1" :name "Alice's Freight Lines"}
                    "c3" {:carrier-id "c3" :name "Carol's Intermodal Carrier"}}
          s (store/mem-store carriers)
          all-c (store/all-carrier-records s)]
      (is (= 3 (count all-c)))
      (is (= "c1" (:carrier-id (first all-c))))
      (is (= "c3" (:carrier-id (last all-c)))))))

(deftest mem-store-vendor-lookup
  (testing "MemStore can store and retrieve maintenance vendors by ID (string keys)"
    (let [vendors {"v1" {:vendor-id "v1" :name "Acme Fleet Maintenance" :registered? true :verified? true}}
          s (store/mem-store {} vendors)]
      (is (some? (store/vendor-record s "v1")))
      (is (nil? (store/vendor-record s "v99"))))))

(deftest mem-store-all-vendor-records
  (testing "MemStore returns all vendors in sorted order"
    (let [vendors {"v2" {:vendor-id "v2" :name "Beta Repair"}
                   "v1" {:vendor-id "v1" :name "Acme Fleet Maintenance"}}
          s (store/mem-store {} vendors)
          all-v (store/all-vendor-records s)]
      (is (= 2 (count all-v)))
      (is (= "v1" (:vendor-id (first all-v)))))))

(deftest mem-store-ledger-append
  (testing "MemStore append-ledger! adds facts to immutable log"
    (let [s (store/mem-store {})
          fact1 {:t :test :data "fact1"}
          fact2 {:t :test :data "fact2"}]
      (is (= 0 (count (store/ledger s))))
      (store/append-ledger! s fact1)
      (is (= 1 (count (store/ledger s))))
      (store/append-ledger! s fact2)
      (is (= 2 (count (store/ledger s)))))))

(deftest mem-store-dispatch-log
  (testing "MemStore commit-record! appends to dispatch-log"
    (let [s (store/mem-store {})
          record {:op :log-shipment-record :carrier-id "c1" :value {:bill-of-lading "BOL-1"}}]
      (is (= 0 (count (store/dispatch-log s))))
      (store/commit-record! s record)
      (is (= 1 (count (store/dispatch-log s))))
      (is (= record (first (store/dispatch-log s)))))))

(deftest mem-store-with-carrier-records
  (testing "MemStore with-carrier-records replaces the carrier directory"
    (let [s (store/mem-store {})
          new-carriers {"c1" {:carrier-id "c1" :name "Alice's Freight Lines"}}]
      (is (= 0 (count (store/all-carrier-records s))))
      (store/with-carrier-records s new-carriers)
      (is (= 1 (count (store/all-carrier-records s)))))))

(deftest mem-store-with-vendor-records
  (testing "MemStore with-vendor-records replaces the vendor directory"
    (let [s (store/mem-store {})
          new-vendors {"v1" {:vendor-id "v1" :name "Acme Fleet Maintenance"}}]
      (is (= 0 (count (store/all-vendor-records s))))
      (store/with-vendor-records s new-vendors)
      (is (= 1 (count (store/all-vendor-records s)))))))

(deftest seed-db-has-demo-data
  (testing "seed-db creates a populated MemStore with demo carriers and vendors"
    (let [s (store/seed-db)]
      (is (> (count (store/all-carrier-records s)) 0))
      (is (some? (store/carrier-record s "carrier-1")))
      (is (some? (store/carrier-record s "carrier-2")))
      (is (some? (store/carrier-record s "carrier-3")))
      (is (> (count (store/all-vendor-records s)) 0))
      (is (some? (store/vendor-record s "vendor-1")))
      (is (some? (store/vendor-record s "vendor-2"))))))

(deftest demo-data-string-key-consistency
  (testing "demo-data uses string keys, not keywords, for carrier-id/vendor-id"
    (let [demo (store/demo-data)
          carriers (:carriers demo)
          vendors (:vendors demo)]
      (doseq [[k v] carriers]
        (is (string? k) "carrier keys must be strings")
        (is (string? (:carrier-id v)) "carrier-id must be string")
        (is (= k (:carrier-id v)) "key must match carrier-id"))
      (doseq [[k v] vendors]
        (is (string? k) "vendor keys must be strings")
        (is (string? (:vendor-id v)) "vendor-id must be string")
        (is (= k (:vendor-id v)) "key must match vendor-id")))))

(deftest store-is-append-only
  (testing "appended facts are immutable and never removed"
    (let [s (store/seed-db)
          fact1 {:t :event1 :data "a"}
          fact2 {:t :event2 :data "b"}]
      (store/append-ledger! s fact1)
      (let [ledger-after-1 (store/ledger s)]
        (store/append-ledger! s fact2)
        (let [ledger-after-2 (store/ledger s)]
          (is (= (count ledger-after-1) (dec (count ledger-after-2))))
          (is (every? #(some (fn [x] (= x %)) ledger-after-2) ledger-after-1)
              "all prior facts must still be present"))))))
